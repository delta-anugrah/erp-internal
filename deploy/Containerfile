# syntax=docker/dockerfile:1
# The erp-internal image: Frappe, ERPNext and HRMS at the tags in versi.json, plus erp_internal from this repo.
# Built by .github/workflows/ci.yml (tested on every pull request to main, pushed to GHCR on a version tag); the
# server only pulls it (deploy/server/).
# Adapted from bpt's deploy/Containerfile; layout follows frappe_docker's images/layered/Containerfile, so
# frappe_docker's compose runs it unchanged.

# frappe_docker's toolchain and runtime images of the release that carries our pins (2026-10-27): build v16.52.1
# and base v16.53.0 are one release (same Python 3.14.10); frappe/build has no v16.53.0 tag.
# Pinned by digest: a moving tag would build different images from the same commit.
ARG BUILD_IMAGE=frappe/build:v16.52.1@sha256:49dd33fcf496e7f8c58dfaab49630d5599d209ddafd9f8f71be38fd60bb8ced5
ARG BASE_IMAGE=frappe/base:v16.53.0@sha256:dd8738e44f977f0529265ca528c27b7d4970e3657e75ea2650f31571cc7addec

FROM ${BUILD_IMAGE} AS builder

USER frappe
WORKDIR /home/frappe

# The three upstream apps, cloned by the tags in versi.json (bench clones with --depth 1 --branch <tag>).
COPY --chown=frappe:0 versi.json /tmp/versi.json
RUN set -eux; \
	versi() { python3 -c 'import json, sys; print(json.load(open("/tmp/versi.json"))[sys.argv[1]])' "$1"; }; \
	bench init --frappe-branch "$(versi frappe)" \
		--no-procfile --no-backups --skip-redis-config-generation /home/frappe/frappe-bench; \
	cd /home/frappe/frappe-bench; \
	bench get-app --branch "$(versi erpnext)" erpnext; \
	bench get-app --branch "$(versi hrms)" hrms; \
	for app in frappe erpnext hrms; do \
		test "$(git -C apps/$app describe --tags --exact-match)" = "$(versi $app)"; \
	done

# The build context is this repo without .git (.dockerignore). bench clones an app from a local repo by branch,
# so it is committed into a one-commit local repo first.
COPY --chown=frappe:0 . /tmp/erp_internal
ARG ERP_SHA=unknown
RUN set -eux; \
	git -C /tmp/erp_internal init -q -b erp-pin; \
	git -C /tmp/erp_internal add -A; \
	git -C /tmp/erp_internal -c user.name=build -c user.email=build@localhost commit -q -m "erp_internal ${ERP_SHA}"; \
	cd /home/frappe/frappe-bench; \
	bench get-app --branch erp-pin /tmp/erp_internal; \
	for app in frappe erpnext hrms; do \
		printf '%s %s\n' "$app" "$(git -C apps/$app describe --tags --exact-match)"; \
	done > BUILD_INFO; \
	printf 'erp_internal %s\n' "${ERP_SHA}" >> BUILD_INFO; \
	echo "{}" > sites/common_site_config.json; \
	find apps -mindepth 1 -path "*/.git" -prune -exec rm -rf {} +; \
	rm -rf /tmp/erp_internal /tmp/versi.json /home/frappe/.cache/yarn /home/frappe/.npm; \
	find logs -type f -exec truncate -s 0 {} +; \
	chmod -R g=u /home/frappe/frappe-bench

FROM ${BASE_IMAGE}

USER frappe
COPY --from=builder --chown=frappe:0 /home/frappe/frappe-bench /home/frappe/frappe-bench
WORKDIR /home/frappe/frappe-bench

# Assets live in the image, not in the `sites` volume: the entrypoint links sites/assets to them on every start,
# so a new image never serves the old bundles.
RUN chmod g=u /home/frappe/frappe-bench && \
	cp -r sites/assets assets && \
	rm -rf sites/assets

VOLUME ["/home/frappe/frappe-bench/sites", "/home/frappe/frappe-bench/logs"]

USER root
# frappe_docker fcc73cf55d202e68ab58885cdcc61a8616d08b51, resources/core (the same files bpt's image uses)
ADD --chmod=755 https://raw.githubusercontent.com/frappe/frappe_docker/fcc73cf55d202e68ab58885cdcc61a8616d08b51/resources/core/main-entrypoint.sh /usr/local/bin/entrypoint.sh
ADD --chmod=755 https://raw.githubusercontent.com/frappe/frappe_docker/fcc73cf55d202e68ab58885cdcc61a8616d08b51/resources/core/start.sh /usr/local/bin/start.sh

USER frappe
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["start.sh"]
