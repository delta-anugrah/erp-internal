# deploy/server/.env on the server, chmod 600, written by `make setup` from its answers. Never commit the real one.
# The passwords are generated on the server and never typed, printed or pasted.
ERP_IMAGE=ghcr.io/delta-anugrah/erp-internal:v0.1.0
SITE=erp.example.co.id
DB_ROOT_PASSWORD=
# Only for `bench new-site`; removed once the Administrator password typed in `make setup` is set.
ADMIN_PASSWORD=
# Optional: where cadangan.sh copies the nightly backup, an rclone remote and path (`rclone config` on the server),
# e.g. b2-erp:erp-internal-cadangan. A plain directory also works for a local test. Without it the backups stay in
# ./cadangan on the server only.
RCLONE_REMOTE=
# Only on a restore drill stack beside production: its local port (default 8080).
# PORT=8081
