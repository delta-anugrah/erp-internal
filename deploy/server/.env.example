# deploy/server/.env on the server, chmod 600. Never commit the real one. The passwords are generated on the server
# (deploy/server/README.md, First install) and never typed, printed or pasted.
ERP_IMAGE=ghcr.io/delta-anugrah/erp-internal:v0.1.0
SITE=erp.example.co.id
DB_ROOT_PASSWORD=
ADMIN_PASSWORD=
# Where cadangan.sh copies the nightly backup: an rclone remote and path (`rclone config` on the server), e.g.
# b2-erp:erp-internal-cadangan. A plain directory also works for a local test.
RCLONE_REMOTE=
